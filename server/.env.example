# Copy to .env and fill in. Nothing here is required to run the server —
# without a key it uses templates and every route still works.

# The only secret. Never put this in the frontend bundle; it is readable by
# anyone who opens devtools there. That is the entire reason this server exists.
ANTHROPIC_API_KEY=

# Where the frontend is served from. Comma-separated. Defaults to * (dev only).
ALLOWED_ORIGIN=http://localhost:5173

# Shared secret for POST /api/job/run. Unset leaves the route open.
JOB_TOKEN=

PORT=8787
JOB_HOUR=5
DATA_FILE=./data/clarity.json
# DISABLE_CRON=1
